NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Local PostgreSQL from `pnpm infra:up` at the repository root.
DATABASE_URL=postgresql://weppo:weppo@localhost:5433/weppo

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:4000

# Optional locally, required to enable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated browser origins allowed to send credentialed requests.
WEB_ORIGINS=http://localhost:3000

# Required in production. Protects /metrics with `Authorization: Bearer <token>`.
METRICS_TOKEN=

# OpenAI Responses API (optional; without it the deterministic demo runner is used)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Optional OAuth integrations. Generate the encryption key with:
# openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=
# Public HTTPS origin for OAuth callbacks (for local development, use a tunnel).
INTEGRATION_CALLBACK_BASE_URL=
INTERCOM_CLIENT_ID=
INTERCOM_CLIENT_SECRET=
SENTRY_CLIENT_ID=
SENTRY_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
