# The harness refuses to create external records unless explicitly enabled.
ENABLE_MOCK_CASES=true

# Sentry ingestion. The DSN is an ingestion identifier, not an auth secret.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=weppo-mock-local
SENTRY_ENVIRONMENT=weppo-mock-local
SENTRY_RELEASE=mock-case@0.1.0

# Optional: upload readable source maps during production builds.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Intercom Messenger in a TEST workspace.
INTERCOM_REGION=eu
INTERCOM_TEST_USER_EXTERNAL_ID=weppo-mock-user-001
INTERCOM_TEST_USER_NAME=Maya Chen
INTERCOM_TEST_USER_EMAIL=maya.chen+weppo-mock@example.com

# Required when Messenger Security / Identity Verification is enforced.
# Get it from Intercom > Settings > Channels > Messenger > Security.
# Keep this server-only value out of browser code and version control.
INTERCOM_MESSENGER_SECRET=

# Public Messenger identifier. This is an App ID, not a private token.
NEXT_PUBLIC_INTERCOM_APP_ID=
